# Copy this file to .env and fill in your API keys.
# .env is gitignored — never commit real credentials.

# ── Speech-to-Text (Deepgram) ─────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ── LLM — agent (OpenAI) ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_MODEL=

# ── LLM — eval judge (OpenAI, separate model) ────────────────────────────────
JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.openai.com/v1/
JUDGE_MODEL=gpt-5.4-2026-06-11

# ── Text-to-Speech (Inworld AI) ───────────────────────────────────────────────
INWORLD_API_KEY=
INWORLD_BASE_URL=
INWORLD_MODEL=

# ── Telemetry UDP listener ────────────────────────────────────────────────────
F1_UDP_IP=0.0.0.0
F1_UDP_PORT=20777

# ── MCP server transport ─────────────────────────────────────────────────────
F1_MCP_TRANSPORT=stdio
F1_MCP_HOST=127.0.0.1
F1_MCP_PORT=20915

# ── In-memory ringbuffer sizes (packets) ─────────────────────────────────────
F1_BUFFER_CAR_TELEMETRY=120
F1_BUFFER_CAR_STATUS=100
F1_BUFFER_CAR_DAMAGE=100
F1_BUFFER_LAP_EVENTS=200
F1_BUFFER_CAR_SETUPS=20
F1_BUFFER_SESSION=200
F1_BUFFER_FORECAST=50
F1_BUFFER_MARSHAL=200
F1_BUFFER_MOTION_LAPS=5
F1_BUFFER_MOTION_SAMPLES=300
F1_BUFFER_LAP_HISTORY=50
F1_BUFFER_POSITION_CHANGES=200
F1_BUFFER_PIT_EVENTS=100
F1_EVENTS_BUFFER=100

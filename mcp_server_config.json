{
  "mcpServers": {
    "f1-telemetry": {
      "command": "uvx",
      "args": ["--from", ".", "python", "-m", "src.mcp.server"],
      "env": {
        "FASTMCP_LOG_LEVEL": "INFO"
      },
      "disabled": false,
      "autoApprove": [
        "get_session_info",
        "get_race_standings", 
        "get_player_telemetry",
        "get_recent_events",
        "get_driver_by_position",
        "get_driver_by_name",
        "get_top_drivers",
        "get_race_summary"
      ],
      "disabledTools": []
    }
  }
}
